{
    "name": "php-shark-tank/anonymizer",
    "description": "Library to anonymize class properties",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2 <8.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95",
        "jangregor/phpstan-prophecy": "^2.3",
        "kubawerlos/php-cs-fixer-custom-fixers": "^3.37",
        "phpspec/prophecy-phpunit": "^2.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.4",
        "psr/cache": "^3.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/expression-language": "^6.4 || ^7.4 || ^8.1",
        "symfony/yaml": "^6.4 || ^7.4 || ^8.1"
    },
    "suggest": {
        "fakerphp/faker": "Needed to use FakerHandler(Registry)",
        "psr/event-dispatcher": "Needed to use EventDispatcher in the default GraphNavigator",
        "psr/cache": "Needed to use CachingLoader",
        "symfony/expression-language": "Needed to use ExpressionExclusionStrategy",
        "symfony/yaml": "Needed to use YamlFileLoader"
    },
    "autoload": {
        "psr-4": {
            "PHPSharkTank\\Anonymizer\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPSharkTank\\Anonymizer\\Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "Eric Hertwig",
            "email": "eric@ehdev.de"
        },
        {
            "name": "Markus Bachmann",
            "email": "markus.bachmann@bachi.biz"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    }
}
